{
  "build": "make swc libswarmrt",
  "suite": "make test-sw",
  "test_runners": [
    { "paths": ["tests/sw/repl/test_"], "cmd": "./bin/swc test {file}", "prove_fails": true },
    { "paths": ["tests/sw/test_"], "cmd": "b=$(mktemp) && ./bin/swc build {file} -o $b && timeout 180 $b", "prove_fails": true },
    { "paths": ["tests/sw/conform/"], "cmd": "d=$(mktemp -d) && { ./bin/swc run {file} 2>/dev/null; echo \"exit=$?\"; } > $d/interp; ./bin/swc build {file} -o $d/bin >/dev/null 2>&1 && { $d/bin 2>/dev/null; echo \"exit=$?\"; } > $d/compiled; diff $d/interp $d/compiled", "prove_fails": false }
  ],
  "required_checks": ["quickstart", "hardening-gates", "macos", "fuzz"],
  "tiers": [
    { "name": "docs", "paths": ["docs/", "README.md", "examples/"], "merge": "auto" },
    { "name": "tests", "paths": ["tests/"], "merge": "auto" },
    { "name": "language", "paths": ["src/swarmrt_lang.c", "src/swarmrt_parse", "lib/"], "merge": "auto", "extra": ["./tests/sw/run_conform.sh"] },
    { "name": "runtime", "paths": ["src/", "Makefile"], "merge": "human", "extra": ["make test-full", "FUZZ_CC=gcc make tsan-gate"] }
  ],
  "default_merge": "human"
}
